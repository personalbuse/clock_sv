# Cloud API keys (only needed for groq/gemini providers)
GROQ_API_KEY=
GOOGLE_API_KEY=

# Provider selection (local dev usa groq, servidor usa ollama/local)
LLM_PROVIDER=groq
STT_PROVIDER=groq
TTS_PROVIDER=gemini

# Override model names (opcional)
LLM_MODEL=llama-3.1-8b-instant
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=sadachbia

WAKE_WORD=servidor
WAKE_WORD_THRESHOLD=80
PTT_KEY=x
LAT=7.3742
LON=-72.6477
VAD_AGGRESSIVENESS=2
TZ=America/Bogota
