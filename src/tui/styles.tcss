Screen {
    background: #000000;
}

#main {
    layout: vertical;
    align: center middle;
    height: 1fr;
    padding-top: 4;
}

ClockWidget {
    width: 100%;
    height: 9;
    content-align: center middle;
}

WeatherWidget {
    width: 100%;
    height: 1;
    content-align: center middle;
}

TimerWidget {
    width: 100%;
    height: auto;
    content-align: center middle;
    margin-top: 0;
}

StatusWidget {
    width: 100%;
    height: 2;
    content-align: center middle;
}

ChatHistoryWidget {
    width: 100%;
    height: auto;
    content-align: center middle;
    dock: bottom;
}
